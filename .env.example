# Copy to .env and fill in. .env is gitignored.

# --- Anthropic ----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The model every chain/agent uses. Change it here, not in code.
RESEARCH_COPILOT_MODEL=claude-opus-5

# --- LangSmith tracing --------------------------------------------------------
# When LANGSMITH_TRACING=true, every chain/model/tool call is recorded as a
# nested "run tree" you can inspect at https://smith.langchain.com.
# No code changes are needed; LangChain reads these env vars on its own.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Phase 2: conversation memory ---------------------------------------------
# trim      = drop the oldest turns when the history exceeds the budget
# summarize = replace the oldest turns with one summary message (costs a model call)
RESEARCH_COPILOT_MEMORY_STRATEGY=trim
# Budget for the conversation history, in tokens. Small on purpose, so pruning
# is easy to trigger and watch.
RESEARCH_COPILOT_MAX_HISTORY_TOKENS=1200

# --- Phase 2: retrieval -------------------------------------------------------
# Local, free, no API key. Changing this invalidates the vector store: vectors
# from different models are not comparable, so re-ingest after a change.
RESEARCH_COPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RESEARCH_COPILOT_CHROMA_DIR=
RESEARCH_COPILOT_COLLECTION=research_copilot
# How many chunks to retrieve per question.
RESEARCH_COPILOT_RETRIEVAL_K=4

# --- Phase 4: persistence -----------------------------------------------------
# Where graph state is snapshotted after every super-step.
#   none    = Phase 3 behaviour; state is discarded when the run ends
#   memory  = kept for the life of the process (good for tests, one session)
#   sqlite  = kept in a file under data/, so separate CLI runs share a thread
RESEARCH_COPILOT_CHECKPOINTER=sqlite
# Defaults to data/checkpoints.sqlite3. data/ is gitignored, which matters here:
# a checkpoint database contains whole conversations.
RESEARCH_COPILOT_CHECKPOINT_DB=

# --- Phase 4: human-in-the-loop -----------------------------------------------
# When true, the graph pauses at interrupt() and waits for approval before an
# answer is committed to the transcript. Needs a checkpointer (there is nowhere
# to park a paused run without one). The --approve flag sets this per command.
RESEARCH_COPILOT_REQUIRE_APPROVAL=false

# Note: RESEARCH_COPILOT_MEMORY_STRATEGY and RESEARCH_COPILOT_MAX_HISTORY_TOKENS
# above are reused by Phase 4's prune_history node, which applies them to the
# *persisted* transcript. Phase 2 applied them to a list that died with the
# process; now they decide what stays on disk. "none" disables pruning.

# --- Phase 5: reflection and planning -----------------------------------------
# When true, a model reviews every draft before it is finalized - the same
# approve/reject gate as RESEARCH_COPILOT_REQUIRE_APPROVAL, with an LLM in the
# reviewer's seat instead of a person. Unlike human review this needs no
# checkpointer: a model call blocks and returns, it does not park the run.
# The --critic flag sets it per command. With both on, the critic reviews first.
RESEARCH_COPILOT_CRITIC=false

# How many critique -> revise rounds one turn may spend. This is NOT the tool
# loop's --max-iterations: the two loops are nested (one revision can itself run
# the tool loop several times) and share nothing but the turn they live in. See
# the `revisions` note in state.py.
#
# It has to exist, and it has to be able to overrule the reviewer: a critic
# asked to find fault will always find some, so "loop until approved" is not a
# terminating condition. 0 reproduces Phase 4 - a rejection ends the run.
RESEARCH_COPILOT_MAX_REVISIONS=2

# When true, a planning node decomposes the question into sub-questions before
# research. Most questions come back undecomposed, which is the intended
# behaviour and not a failure - a planner that never declines to plan is a cost
# multiplier. The --plan flag sets it per command.
RESEARCH_COPILOT_PLAN=false

# --- Phase 7: provider switch ---
# "anthropic" (default) or "groq". Also settable per run: research-copilot --provider groq ...
RESEARCH_COPILOT_PROVIDER=anthropic
# Groq (free tier: https://console.groq.com/keys). Needs: pip install -e ".[groq]"
GROQ_API_KEY=
RESEARCH_COPILOT_GROQ_MODEL=llama-3.3-70b-versatile
