# Copy to .env and fill in. .env is gitignored.

# --- Anthropic ----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The model every chain/agent uses. Change it here, not in code.
RESEARCH_COPILOT_MODEL=claude-opus-5

# --- LangSmith tracing --------------------------------------------------------
# When LANGSMITH_TRACING=true, every chain/model/tool call is recorded as a
# nested "run tree" you can inspect at https://smith.langchain.com.
# No code changes are needed; LangChain reads these env vars on its own.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Phase 2: conversation memory ---------------------------------------------
# trim      = drop the oldest turns when the history exceeds the budget
# summarize = replace the oldest turns with one summary message (costs a model call)
RESEARCH_COPILOT_MEMORY_STRATEGY=trim
# Budget for the conversation history, in tokens. Small on purpose, so pruning
# is easy to trigger and watch.
RESEARCH_COPILOT_MAX_HISTORY_TOKENS=1200

# --- Phase 2: retrieval -------------------------------------------------------
# Local, free, no API key. Changing this invalidates the vector store: vectors
# from different models are not comparable, so re-ingest after a change.
RESEARCH_COPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RESEARCH_COPILOT_CHROMA_DIR=
RESEARCH_COPILOT_COLLECTION=research_copilot
# How many chunks to retrieve per question.
RESEARCH_COPILOT_RETRIEVAL_K=4
